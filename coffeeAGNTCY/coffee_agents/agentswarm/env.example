# ============================================================================
# AgentSwarm - Webex Contact Center Multi-Agent System Configuration
# Based on Cisco Outshift's CoffeeAgentcy
# ============================================================================

# ============================================================================
# AI Backend Selection (REQUIRED)
# ============================================================================
# Options: "circuit" (Cisco internal) or "litellm" (OpenAI, GROQ, Azure)
AI_BACKEND="circuit"

# ============================================================================
# Option 1: Cisco CIRCUIT API (Recommended for Cisco demos)
# ============================================================================
# FREE for hackathons! No rate limits like OpenAI free tier
# VPN Required - Get credentials from CIRCUIT API Portal
# Free tier models: gpt-4o-mini (30 req/min), gpt-4.1 (15 req/min)

CIRCUIT_CLIENT_ID="your_okta_client_id"
CIRCUIT_CLIENT_SECRET="your_okta_client_secret"
CIRCUIT_APPKEY="your_circuit_appkey"
CIRCUIT_MODEL="gpt-4o-mini"

# ============================================================================
# Option 2: LiteLLM (OpenAI, GROQ, Azure)
# ============================================================================
# Set AI_BACKEND="litellm" to use these options

# GROQ (FREE & Fast)
# LLM_MODEL="groq/llama-3.3-70b-versatile"
# GROQ_API_KEY="your_groq_api_key_here"

# OpenAI
# LLM_MODEL="openai/gpt-4o-mini"
# OPENAI_API_KEY="your_openai_api_key_here"

# Azure OpenAI
# LLM_MODEL="azure/your_deployment_name"
# AZURE_API_BASE="https://your-resource.openai.azure.com/"
# AZURE_API_KEY="your_azure_api_key"
# AZURE_API_VERSION="2024-02-15-preview"

# ============================================================================
# Webex Configuration (REQUIRED for Webex integration)
# ============================================================================
WEBEX_BOT_TOKEN="your_webex_bot_token_here"
WEBEX_BOT_EMAIL="your_bot_email@webex.bot"
WEBEX_ROOM_ID="your_test_room_id_here"
BOT_QUEUE_NAME="agentswarm"

# Webhook URL (update when deployed)
WEBEX_WEBHOOK_URL="http://localhost:8000/webhooks/webex"

# ============================================================================
# Observability Configuration
# ============================================================================
OTLP_HTTP_ENDPOINT="http://localhost:4318"
LOGGING_LEVEL="INFO"

# ============================================================================
# Agent Ports
# ============================================================================
ORCHESTRATOR_PORT=8000
KNOWLEDGE_AGENT_PORT=8001
CRM_AGENT_PORT=8002
TICKET_AGENT_PORT=8003
ESCALATION_AGENT_PORT=8004
