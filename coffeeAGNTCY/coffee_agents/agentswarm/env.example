# ============================================================================
# AgentSwarm - Webex Contact Center Multi-Agent System Configuration
# Based on Cisco Outshift's CoffeeAgentcy
# ============================================================================

# ============================================================================
# LLM Configuration (REQUIRED)
# ============================================================================

# Option 1: GROQ (Recommended - FREE & Fast)
LLM_MODEL="groq/llama-3.3-70b-versatile"
GROQ_API_KEY="your_groq_api_key_here"

# Option 2: OpenAI
# LLM_MODEL="openai/gpt-4o-mini"
# OPENAI_API_KEY="your_openai_api_key_here"

# Option 3: Azure OpenAI
# LLM_MODEL="azure/your_deployment_name"
# AZURE_API_BASE="https://your-resource.openai.azure.com/"
# AZURE_API_KEY="your_azure_api_key"
# AZURE_API_VERSION="2024-02-15-preview"

# ============================================================================
# Webex Configuration (REQUIRED for Webex integration)
# ============================================================================
WEBEX_BOT_TOKEN="your_webex_bot_token_here"
WEBEX_BOT_EMAIL="your_bot_email@webex.bot"
WEBEX_ROOM_ID="your_test_room_id_here"

# Webhook URL (update when deployed)
WEBEX_WEBHOOK_URL="http://localhost:8000/webhooks/webex"

# ============================================================================
# AGNTCY Transport Configuration
# ============================================================================
# Transport protocol: SLIM (default) or NATS
DEFAULT_MESSAGE_TRANSPORT="SLIM"

# SLIM endpoint
TRANSPORT_SERVER_ENDPOINT="http://localhost:46357"

# ============================================================================
# Observability Configuration
# ============================================================================
OTLP_HTTP_ENDPOINT="http://localhost:4318"
LOGGING_LEVEL="INFO"

# ============================================================================
# Agent Ports
# ============================================================================
ORCHESTRATOR_PORT=8000
KNOWLEDGE_AGENT_PORT=8001
CRM_AGENT_PORT=8002
TICKET_AGENT_PORT=8003
ESCALATION_AGENT_PORT=8004


